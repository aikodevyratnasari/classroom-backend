{
  "name": "classroom-backend",
  "version": "1.0.0",
  "description": "Simple Express.js server in TypeScript",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "db:generate": "tsx ./node_modules/drizzle-kit/bin.cjs generate",
    "db:push": "tsx ./node_modules/drizzle-kit/bin.cjs push",
    "db:migrate": "tsx ./node_modules/drizzle-kit/bin.cjs migrate"
  },
  "dependencies": {
    "dotenv": "^16.6.1",
    "drizzle-orm": "^0.45.1",
    "express": "^4.18.2",
    "postgres": "^3.4.4"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.19.33",
    "drizzle-kit": "^0.31.9",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  }
}
